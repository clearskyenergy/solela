rules_version = '2';

/* ══════════════════════════════════════════════════════════════════════
   comedSites — sites identified on the ComEd hosting-capacity map.
   ----------------------------------------------------------------------
   Merge this block into the existing clearsky-portal ruleset alongside
   `projects`, `team_*` etc. It follows the same convention: a document
   belongs to an org, and a user's org is their email domain.

   The portal index reads this collection. The ComEd Capacity tool writes
   it. Reps may only touch rows inside their own org.
   ══════════════════════════════════════════════════════════════════════ */

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    // A user's org is the domain of their email — matches userOrg() elsewhere
    // in this ruleset. ClearSky staff are mapped onto the tenant they support.
    function userOrg() {
      return request.auth.token.email.split('@')[1].lower();
    }

    function orgFor(org) {
      return userOrg() == org
             || (userOrg() == 'csebuilders.com' && org == 'chileasing.com');
    }

    match /comedSites/{siteId} {

      allow read: if signedIn() && orgFor(resource.data.orgId);

      // A new site must be stamped with the creator's own org — this is what
      // stops one tenant seeding rows into another tenant's pipeline.
      allow create: if signedIn()
                    && request.resource.data.orgId is string
                    && orgFor(request.resource.data.orgId)
                    && request.resource.data.siteName is string;

      // orgId is immutable after creation; a row cannot be moved between orgs.
      allow update: if signedIn()
                    && orgFor(resource.data.orgId)
                    && request.resource.data.orgId == resource.data.orgId;

      allow delete: if signedIn() && orgFor(resource.data.orgId);
    }
  }
}
