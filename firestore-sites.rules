rules_version = '2';

/* ══════════════════════════════════════════════════════════════════════
   ClearSky-OMEGA · `sites` collection
   ----------------------------------------------------------------------
   Sites identified on the ComEd hosting-capacity map. Same tenancy model
   as `projects`: every doc carries an `orgId` equal to the signed-in
   user's email domain, and that is the only thing a user may read.

   MERGE THIS into the existing firestore.rules alongside the projects
   block — it is a fragment, not a standalone ruleset.
   ══════════════════════════════════════════════════════════════════════ */

service cloud.firestore {
  match /databases/{database}/documents {

    // The tenant a signed-in user belongs to. Matches the portal's
    // resolveWorkspace() — orgId IS the email domain.
    function userOrg() {
      return request.auth.token.email.lower().split('@')[1];
    }

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    match /sites/{siteId} {

      // Read: only sites belonging to your own org. The dashboard queries
      // where('orgId','==',currentOrg), which satisfies this.
      allow read: if signedIn() && resource.data.orgId == userOrg();

      // Create: the new doc must be stamped with YOUR org — a user cannot
      // plant a site inside another tenant.
      allow create: if signedIn()
                    && request.resource.data.orgId == userOrg()
                    && request.resource.data.keys().hasAll(['orgId','status']);

      // Update: must stay inside your org, and orgId itself is immutable.
      // Without the second clause a rep could move a site to another tenant.
      allow update: if signedIn()
                    && resource.data.orgId == userOrg()
                    && request.resource.data.orgId == resource.data.orgId;

      // Delete: any member of the owning org. Tighten to an admin claim
      // here if you want deletes restricted to managers.
      allow delete: if signedIn() && resource.data.orgId == userOrg();
    }
  }
}
